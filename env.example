# Server only. Copy to .env on the deployment host or inject via a secret manager.
PUBLIC_ORIGIN=https://airtime.example.com
DATABASE_URL=postgresql://airwaves:replace_db_app_password@db:5432/airwaves
SESSION_SECRET=replace_with_64_random_hex_characters
PORT=8787
LOCAL_HTTP=false
# True only for the bundled private Docker database or local development.
DB_PRIVATE_NO_TLS=true
TRUST_CADDY_PROXY=true

# Start closed. Keep PROVIDERS_ENABLED true when pausing an approved live checkout.
PROVIDERS_ENABLED=false
PURCHASES_ENABLED=false
ENABLED_NETWORKS=
SUPPORT_EMAIL=
TERMS_URL=
PRIVACY_URL=
TERMS_VERSION=
# Optional per-network ranges and rates, with up to four decimal places.
AIRWAVES_SAFARICOM_MIN=10
AIRWAVES_SAFARICOM_MAX=10000
AIRWAVES_SAFARICOM_DISCOUNT=0
AIRWAVES_AIRTEL_MIN=10
AIRWAVES_AIRTEL_MAX=10000
AIRWAVES_AIRTEL_DISCOUNT=0
AIRWAVES_TELKOM_MIN=10
AIRWAVES_TELKOM_MAX=10000
AIRWAVES_TELKOM_DISCOUNT=0
AIRWAVES_JTL_MIN=10
AIRWAVES_JTL_MAX=10000
AIRWAVES_JTL_DISCOUNT=0

# Daraja M-Pesa Express. Select CustomerBuyGoodsOnline only if approved for your Till.
MPESA_ENVIRONMENT=sandbox
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_PARTY_B=
MPESA_CALLBACK_TOKEN=

# Banricom SMS Sender ID. Confirm the response path and value with your provider.
BANRICOM_SMS_URL=https://banricom.com/api/v3/sms/messages
BANRICOM_SMS_APP_ID=
BANRICOM_SMS_API_KEY=
BANRICOM_SMS_SHORTCODE=
BANRICOM_SMS_ACCEPTANCE_PATH=
BANRICOM_SMS_ACCEPTANCE_VALUE=

# Safaricom PreTUPS / Etopup for Safaricom airtime.
SAFARICOM_CONSUMER_KEY=
SAFARICOM_CONSUMER_SECRET=
SAFARICOM_SENDER=
SAFARICOM_SERVICE_PIN=
SAFARICOM_ACCEPTANCE_VALUE=

# Banricom reseller airtime for explicitly enabled non-Safaricom networks.
BANRICOM_AUTHORIZATION=
BANRICOM_PASSKEY=
BANRICOM_ACCEPTANCE_VALUE=
BANRICOM_CALLBACK_TOKEN=
BANRICOM_DELIVERED_STATUS_VALUES=
BANRICOM_FAILED_STATUS_VALUES=
